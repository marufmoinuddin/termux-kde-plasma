#compdef kdestart

# zsh completion for kdestart
# Install: place in ~/.zsh/completions/ (with 'fpath' including it) and run compinit

_kdestart() {
    # shellcheck disable=SC2034 # zsh completion uses opts via _describe
    local -a opts
    opts=(
        'zink[Launch Plasma with native Turnip+Zink GPU acceleration]'
        'virgl[Launch Plasma with VirGL fallback]'
        'software[Launch Plasma with software rendering (diagnostic)]'
        '--konsole[Launch Konsole-only in a light Openbox session]'
        '--app[Launch a single app in a light Openbox session]:app:(konsole dolphin chromium firefox kate)'
        '--nogpu[Launch without the GPU environment]'
        '--help[Show help]'
    )
    _describe 'kdestart options' opts
}

_kdestart "$@"
